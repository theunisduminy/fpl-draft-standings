# --- The league -------------------------------------------------------------
# The draft league this app reports on.
#
# Find it in the URL when viewing your league on draft.premierleague.com:
#   https://draft.premierleague.com/league/<FPL_LEAGUE_ID>/standings
#
# League IDs are season-scoped: a renewed league is issued a new ID each August,
# so expect to change this at the start of every season.
FPL_LEAGUE_ID=8337

# --- Database ---------------------------------------------------------------
# Neon Postgres. Copy from your Neon project's connection details (the pooled
# connection string). Server-only — never prefix with NEXT_PUBLIC_.
NEON_CONNECTION_STRING_PROD=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# --- Auth -------------------------------------------------------------------
# Neon Auth (managed Better Auth). The base URL is on your Neon project's Auth
# tab. Note it includes the cluster segment (e.g. `.c-6.`) — the URL without it
# resolves but answers 500.
NEON_AUTH_BASE_URL=https://ep-xxx.neonauth.c-N.region.aws.neon.tech/neondb/auth

# Signs session cookies. Minimum 32 characters; generate with:
#   openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=replace-me-with-at-least-32-characters

# Who may sign in. The league is eight known people, so membership is an
# allowlist rather than open sign-up. Comma- or whitespace-separated.
ALLOWED_EMAILS=one@example.com,two@example.com
